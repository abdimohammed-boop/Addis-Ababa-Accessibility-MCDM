"""
Integrated MCA-TOPSIS & MCDM Benchmarking Script
Author: Abdi Mohammed Ibrahim
Description: Computes AHP-Entropy hybrid weights and executes MCA-TOPSIS, SAW, 
             PROMETHEE II (Type I Usual preference, uniform positive indicators), and VIKOR.
"""

import numpy as np
import pandas as pd
from scipy.stats import spearmanr

# 1. Load Corridor Data (14 Criteria: 9 Objective, 5 Subjective)
data = {
    'Corridor': ['R1 (Rwanda)', 'R2 (Dembel/Atlas)', 'R3 (Urael)', 'R4 (22 Sq)', 'R5 (Bole Michael)'],
    'C1_Sidewalks': [2.20, 1.80, 1.50, 1.90, 0.90],
    'C2_CurbCuts': [80.0, 55.0, 35.0, 60.0, 10.0],
    'C3_Tactile': [65.0, 40.0, 20.0, 50.0, 5.0],
    'C4_Zebra': [3.8, 3.0, 2.4, 3.2, 1.5],
    'C5_Connectivity': [4.0, 3.2, 2.5, 3.3, 1.8],
    'C6_Parking': [3.5, 2.8, 2.0, 2.5, 1.2],
    'C7_Signage': [3.8, 3.0, 2.2, 2.8, 1.5],
    'C8_BusStops': [3.5, 2.7, 2.0, 2.4, 1.1],
    'C9_BusRamps': [70.0, 50.0, 30.0, 45.0, 10.0],
    'C10_Sub_PedFacilities': [4.1, 3.4, 2.8, 3.0, 1.6],
    'C11_Sub_Crossings': [3.8, 3.1, 2.4, 2.7, 1.4],
    'C12_Sub_PubTransport': [3.2, 2.6, 2.0, 2.3, 1.2],
    'C13_Sub_Parking': [2.9, 2.2, 1.7, 1.9, 1.0],
    'C14_Sub_Integration': [3.5, 2.8, 2.1, 2.5, 1.3]
}

df = pd.DataFrame(data)
X = df.iloc[:, 1:].values
n_alternatives, n_criteria = X.shape

# 2. AHP - Entropy Hybrid Weighting
w_ahp = np.array([0.1137, 0.1767, 0.2874, 0.0649, 0.0649, 0.0589, 0.0589, 0.0568, 0.1178, 
                  0.3046, 0.2587, 0.1583, 0.1551, 0.1234])
w_ahp /= np.sum(w_ahp)

X_norm_e = X / X.sum(axis=0)
X_norm_e = np.where(X_norm_e == 0, 1e-12, X_norm_e)
k = 1.0 / np.log(n_alternatives)
E = -k * np.sum(X_norm_e * np.log(X_norm_e), axis=0)
d = 1.0 - E
w_entropy = d / np.sum(d)

alpha = 0.70
w_hybrid = alpha * w_ahp + (1.0 - alpha) * w_entropy
w_hybrid /= np.sum(w_hybrid)

# 3. MCA-TOPSIS Algorithm
X_min = X.min(axis=0)
X_max = X.max(axis=0)
X_min_max = (X - X_min) / (X_max - X_min)

weighted_norm = X_min_max * w_hybrid

A_plus = np.max(weighted_norm, axis=0)
A_minus = np.min(weighted_norm, axis=0)

D_plus = np.sqrt(np.sum((weighted_norm - A_plus)**2, axis=1))
D_minus = np.sqrt(np.sum((weighted_norm - A_minus)**2, axis=1))

C_plus = D_minus / (D_plus + D_minus)
df['MCA_TOPSIS_Cj'] = C_plus
df['MCA_TOPSIS_Rank'] = df['MCA_TOPSIS_Cj'].rank(ascending=False).astype(int)

# 4. SAW Algorithm
S_saw = np.sum(X_min_max * w_hybrid, axis=1)
df['SAW_Score'] = S_saw
df['SAW_Rank'] = df['SAW_Score'].rank(ascending=False).astype(int)

# 5. PROMETHEE II Algorithm (Type I Usual Preference - Uniform Positive Indicators)
pi_matrix = np.zeros((n_alternatives, n_alternatives))
for i in range(n_alternatives):
    for k_alt in range(n_alternatives):
        if i != k_alt:
            P_sum = 0.0
            for j in range(n_criteria):
                diff = X_min_max[i, j] - X_min_max[k_alt, j]
                P = 1.0 if diff > 0 else 0.0
                P_sum += w_hybrid[j] * P
            pi_matrix[i, k_alt] = P_sum

phi_net = (np.sum(pi_matrix, axis=1) - np.sum(pi_matrix, axis=0)) / (n_alternatives - 1)
df['PROMETHEE_Net'] = phi_net
df['PROMETHEE_Rank'] = df['PROMETHEE_Net'].rank(ascending=False).astype(int)

# 6. VIKOR Algorithm
best_val = np.max(X_min_max, axis=0)
worst_val = np.min(X_min_max, axis=0)
S_i = np.sum(w_hybrid * (best_val - X_min_max) / (best_val - worst_val), axis=1)
R_i = np.max(w_hybrid * (best_val - X_min_max) / (best_val - worst_val), axis=1)

v = 0.5
Q_i = v * (S_i - np.min(S_i)) / (np.max(S_i) - np.min(S_i)) + (1.0 - v) * (R_i - np.min(R_i)) / (np.max(R_i) - np.min(R_i))
df['VIKOR_Q'] = Q_i
df['VIKOR_Rank'] = df['VIKOR_Q'].rank(ascending=True).astype(int)

# 7. Print Results & Rank Concordance Verification
print("\n--- FINAL BENCHMARKING RESULTS ---")
print(df[['Corridor', 'MCA_TOPSIS_Rank', 'SAW_Rank', 'PROMETHEE_Rank', 'VIKOR_Rank']])

rho_val, _ = spearmanr(df['MCA_TOPSIS_Rank'], df['SAW_Rank'])
print(f"\nSpearman Rank Correlation (MCA-TOPSIS vs SAW): rho = {rho_val:.2f}")

rho_topsis_saw, _ = spearmanr(df['TOPSIS_Rank'], df['SAW_Rank'])
rho_topsis_prom, _ = spearmanr(df['TOPSIS_Rank'], df['PROMETHEE_Rank'])

print(f"\nSpearman Correlation (TOPSIS vs SAW): rho = {rho_topsis_saw:.2f}")
print(f"Spearman Correlation (TOPSIS vs PROMETHEE II): rho = {rho_topsis_prom:.2f}")
